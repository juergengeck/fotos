{
  "name": "@refinio/fotos.core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic face detection and recognition for fotos",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./faces": {
      "import": "./dist/faces.js",
      "types": "./dist/faces.d.ts"
    },
    "./ingest": {
      "import": "./dist/ingest/index.js",
      "types": "./dist/ingest/index.d.ts"
    },
    "./service-contract": {
      "import": "./dist/service-contract.js",
      "types": "./dist/service-contract.d.ts"
    },
    "./filesystem": {
      "import": "./dist/fotos-file-system.js",
      "types": "./dist/fotos-file-system.d.ts"
    },
    "./received-shares": {
      "import": "./dist/received-shares.js",
      "types": "./dist/received-shares.d.ts"
    },
    "./shared-filesystem": {
      "import": "./dist/shared-fotos-file-system.js",
      "types": "./dist/shared-fotos-file-system.d.ts"
    },
    "./sync-rules": {
      "import": "./dist/sync-rules.js",
      "types": "./dist/sync-rules.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "exifreader": "^4.37.0",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@refinio/sync.core": "file:../../sources/one/packages/sync.core",
    "typescript": "^5.4.0",
    "vitest": "catalog:",
    "@refinio/meaning.core": "file:../../sources/one/packages/meaning.core",
    "@refinio/one.core": "file:../../sources/one/packages/one.core",
    "@refinio/trust.core": "file:../../sources/one/packages/trust.core",
    "@refinio/trie.core": "file:../../sources/one/packages/trie.core",
    "@refinio/one.models": "file:../../sources/one/packages/one.models",
    "@refinio/provenance.core": "file:../../sources/one/packages/provenance.core"
  },
  "peerDependencies": {
    "@refinio/meaning.core": "*",
    "@refinio/one.core": "*",
    "@refinio/trust.core": "*",
    "@refinio/trie.core": "*",
    "@refinio/provenance.core": "*",
    "@refinio/sync.core": "*"
  }
}
