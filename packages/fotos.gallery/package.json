{
  "name": "@refinio/fotos.gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*.js": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*.js": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/*.js": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./types/*.js": {
      "types": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.14"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm typecheck && pnpm pack --pack-destination dist",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src"
  ]
}
