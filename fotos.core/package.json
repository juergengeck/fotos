{
  "name": "@refinio/fotos.core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic face detection and recognition for fotos",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./faces": {
      "import": "./dist/faces.js",
      "types": "./dist/faces.d.ts"
    },
    "./similarity": {
      "import": "./dist/similarity.js",
      "types": "./dist/similarity.d.ts"
    },
    "./catalog": {
      "import": "./dist/fotos-catalog.js",
      "types": "./dist/fotos-catalog.d.ts"
    },
    "./content-hash": {
      "types": "./dist/content-hash.d.ts",
      "import": "./dist/content-hash.js"
    },
    "./ingest": {
      "import": "./dist/ingest/index.js",
      "types": "./dist/ingest/index.d.ts"
    },
    "./service-contract": {
      "import": "./dist/service-contract.js",
      "types": "./dist/service-contract.d.ts"
    },
    "./filesystem": {
      "import": "./dist/fotos-file-system.js",
      "types": "./dist/fotos-file-system.d.ts"
    },
    "./received-shares": {
      "import": "./dist/received-shares.js",
      "types": "./dist/received-shares.d.ts"
    },
    "./shared-filesystem": {
      "import": "./dist/shared-fotos-file-system.js",
      "types": "./dist/shared-fotos-file-system.d.ts"
    },
    "./share-publication": {
      "types": "./dist/share-publication.d.ts",
      "import": "./dist/share-publication.js"
    },
    "./sync-rules": {
      "import": "./dist/sync-rules.js",
      "types": "./dist/sync-rules.d.ts"
    },
    "./one-core-config": {
      "import": "./dist/one-core-config.js",
      "types": "./dist/one-core-config.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@refinio/media.core": "workspace:*",
    "@refinio/meaning.core": "workspace:*",
    "@refinio/one.core": "workspace:*",
    "@refinio/trust.core": "workspace:*",
    "@refinio/trie.core": "workspace:*",
    "exifreader": "^4.37.0",
    "@refinio/provenance.core": "workspace:*"
  },
  "devDependencies": {
    "@refinio/sync.core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "^5.4.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@refinio/sync.core": "*"
  }
}
