{
  "expo": {
    "name": "fotos.one",
    "slug": "fotos-one",
    "scheme": "fotosone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fotos.ios",
      "appleTeamId": "26W8AC52QS",
      "infoPlist": {
        "NSBonjourServices": [
          "_one-refinio._udp"
        ],
        "NSLocalNetworkUsageDescription": "fotos uses the local network to discover trusted devices for secure peer-to-peer gallery sync.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "fotos.android",
      "permissions": ["android.permission.CHANGE_WIFI_MULTICAST_STATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ],
      "./plugins/withFotosShareExtension",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library so fotos can reference originals by content hash and reuse trusted analysis across devices.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos you export to Apple Photos."
        }
      ],
      "@refinio/media.expo/app.plugin.cjs",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fotos-expo-template"
      }
    }
  }
}
