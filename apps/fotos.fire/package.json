  "name": "@refinio/fotos.fire",
  "description": "fotos.one native photo viewer for Amazon Fire TV",
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "prebuild": "EXPO_TV=1 expo prebuild --platform android --no-install",
    "android": "EXPO_TV=1 expo run:android",
    "typecheck": "tsc --noEmit",
    "build:apk": "node scripts/build-apk.mjs",
    "deploy": "node scripts/deploy.mjs",
    "ios": "expo run:ios",
    "build": "EXPO_TV=1 expo export --platform android --output-dir dist",
    "test": "node --test src/ui/navigation.test.mjs src/runtime/runtime.test.mjs"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
