{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@refinio/fotos.ui": ["../../fotos.ui/src/index.ts"],
      "@refinio/assembly.core": ["../../../one/packages/assembly.core/dist/index.d.ts"],
      "@refinio/assembly.core/*": ["../../../one/packages/assembly.core/dist/*"],
      "@refinio/source.media": ["../../../one/packages/source.media/dist/index.d.ts"],
      "@refinio/source.media/*": ["../../../one/packages/source.media/dist/*"],
      "@refinio/source.core": ["../../../one/packages/source.core/dist/index.d.ts"],
      "@refinio/source.core/*": ["../../../one/packages/source.core/dist/*"],
      "@refinio/media.core": ["../../../one/packages/media.core/dist/index.d.ts"],
      "@refinio/media.core/*": ["../../../one/packages/media.core/dist/*"],
      "@refinio/recovery.core": ["../../../one/packages/recovery.core/dist/index.d.ts"],
      "@refinio/trust.core/*": ["../../../one/packages/trust.core/dist/*"],
      "@refinio/trust.core/recipes": ["../../../one/packages/trust.core/dist/recipes/index.d.ts"]
    }
  },
  "include": [
    "src",
    "../../../one/packages/local.core/src/transformers.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/sw.ts",
    "src/workers/**/*",
    "node_modules/@refinio/one.core/lib/system/expo/**/*",
    "node_modules/@refinio/one.core/lib/system/nodejs/**/*",
    "node_modules/@refinio/one.core/src/system/expo/**/*",
    "node_modules/@refinio/one.core/src/system/nodejs/**/*"
  ]
}
